import React, { useState, useEffect, useRef, useCallback } from 'react';

const BLUE = '#0284C7';
const BL = '#0A0A0A';
const WH = '#FFFFFF';
const GREY = '#F8FAFC';

// ── Voice hook ──────────────────────────────────────────────────────────────
function useSpeech() {
  const recognitionRef = useRef(null);
  const baseTextRef = useRef('');
  const onUpdateRef = useRef(null);
  const [listening, setListening] = useState(false);

  const stop = useCallback(() => {
    if (recognitionRef.current) {
      recognitionRef.current.onend = null;
      recognitionRef.current.onerror = null;
      recognitionRef.current.onresult = null;
      recognitionRef.current.abort();
      recognitionRef.current = null;
    }
    setListening(false);
  }, []);

  const start = useCallback((currentValue, onUpdate) => {
    const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SR) { alert('Voice input requires Chrome.'); return; }
    if (recognitionRef.current) { stop(); return; }
    onUpdateRef.current = onUpdate;
    const r = new SR();
    r.lang = 'en-NG';
    r.continuous = true;
    r.interimResults = true;
    r.maxAlternatives = 1;
    recognitionRef.current = r;
    baseTextRef.current = (currentValue || '').trim();
    r.onstart = () => setListening(true);
    r.onresult = (event) => {
      let interim = '', final = '';
      for (let i = event.resultIndex; i < event.results.length; i++) {
        const t = event.results[i][0].transcript;
        if (event.results[i].isFinal) final += t; else interim += t;
      }
      if (final) baseTextRef.current = baseTextRef.current ? baseTextRef.current + ' ' + final.trim() : final.trim();
      const display = baseTextRef.current ? (interim ? baseTextRef.current + ' ' + interim : baseTextRef.current) : interim;
      if (onUpdateRef.current) onUpdateRef.current(display);
    };
    r.onend = () => { if (onUpdateRef.current) onUpdateRef.current(baseTextRef.current); setListening(false); recognitionRef.current = null; };
    r.onerror = (e) => { if (e.error !== 'no-speech' && e.error !== 'aborted') console.error('Voice:', e.error); setListening(false); recognitionRef.current = null; };
    r.start();
  }, [stop]);

  return { listening, start, stop, baseTextRef };
}

// ── Storage helpers (localStorage per project) ───────────────────────────────
const STORAGE_KEY = (projectId) => `pmbuddy_chat_${projectId}`;

function loadConversation(projectId) {
  try {
    const saved = localStorage.getItem(STORAGE_KEY(projectId));
    return saved ? JSON.parse(saved) : [];
  } catch { return []; }
}

function saveConversation(projectId, messages) {
  try {
    // Keep last 50 messages per project to avoid storage bloat
    const trimmed = messages.slice(-50);
    localStorage.setItem(STORAGE_KEY(projectId), JSON.stringify(trimmed));
  } catch {}
}

// ── Build context string from project data ───────────────────────────────────
function buildProjectContext(project) {
  if (!project) return '';
  const milestones = (project.milestones || []);
  const doneMilestones = milestones.filter(m => m.status === 'done').length;
  const pendingMilestones = milestones.filter(m => m.status === 'pending').length;
  const overdueMilestones = milestones.filter(m => {
    if (m.status === 'done') return false;
    return m.date && new Date(m.date) < new Date();
  }).length;
  const openRisks = (project.risks || []).filter(r => r.status === 'open');
  const highRisks = openRisks.filter(r => r.level === 'high');
  const teamCount = (project.team || []).length;
  const end = project.timeline?.end;
  const daysLeft = end ? Math.ceil((new Date(end) - new Date()) / 86400000) : null;
  const isCampaign = project.industry === 'Campaign';

  return `
Project Name: ${project.name}
Type: ${isCampaign ? 'Campaign / Short-term initiative' : 'Project'}
Goal: ${project.scope?.goal || project.description || 'Not clearly stated'}
Description: ${project.description || 'Not provided'}
Status: ${project.status || 'active'}
Timeline: ${project.timeline?.start || 'Not set'} to ${project.timeline?.end || 'Not set'}
Days Remaining: ${daysLeft !== null ? daysLeft + ' days' : 'Unknown'}
Milestones: ${doneMilestones} done, ${pendingMilestones} pending, ${overdueMilestones} overdue
Open Risks: ${openRisks.length} total, ${highRisks.length} high priority
Team Members: ${teamCount}
Industry: ${project.industry || 'Not specified'}
Methodology: ${project.methodology || 'Not specified'}
Success Metrics: ${project.scope?.successMetrics || 'Not defined'}
Target Audience: ${project.scope?.targetAudience || 'Not specified'}
`.trim();
}

// ── Build opening nudge based on project state ────────────────────────────────
function buildOpeningNudge(project) {
  if (!project) return "Hey, I'm your PM Buddy. Think of me as your personal project manager. I'm here to guide you, catch what you might miss and make sure your project stays on track. Let's build this properly.";

  const milestones = project.milestones || [];
  const risks = project.risks || [];
  const team = project.team || [];
  const openRisks = risks.filter(r => r.status === 'open');
  const highRisks = openRisks.filter(r => r.level === 'high');
  const overdue = milestones.filter(m => m.status !== 'done' && m.date && new Date(m.date) < new Date());
  const end = project.timeline?.end;
  const daysLeft = end ? Math.ceil((new Date(end) - new Date()) / 86400000) : null;
  const isCampaign = project.industry === 'Campaign';

  // Priority nudges — most urgent first
  if (overdue.length > 0) {
    return `Hey, I'm your PM Buddy. You have ${overdue.length} overdue milestone${overdue.length > 1 ? 's' : ''} on ${project.name}. That needs your attention first. Want me to help you figure out what to do next?`;
  }
  if (highRisks.length > 0) {
    return `Hey, I'm your PM Buddy. I can see ${highRisks.length} high priority risk${highRisks.length > 1 ? 's' : ''} sitting open on ${project.name}. Those should not be ignored. Do you have a plan to manage them?`;
  }
  if (daysLeft !== null && daysLeft <= 7 && daysLeft > 0) {
    return `Hey, I'm your PM Buddy. ${project.name} is due in ${daysLeft} day${daysLeft > 1 ? 's' : ''}. Are you confident everything is on track? Let's do a quick check.`;
  }
  if (team.length <= 1 && !isCampaign) {
    return `Hey, I'm your PM Buddy. I notice ${project.name} doesn't have any team members added yet. If other people are involved in this, now is a good time to invite them so everyone is working from the same plan.`;
  }
  if (risks.length === 0) {
    return `Hey, I'm your PM Buddy. I'm looking at ${project.name} and I don't see any risks logged yet. Every project has risks. Let's make sure yours are documented so nothing catches you off guard.`;
  }
  if (!project.scope?.goal && !project.description) {
    return `Hey, I'm your PM Buddy. The goal for ${project.name} is not clearly defined yet. A project without a clear goal is hard to track and even harder to close successfully. Want to work on that?`;
  }

  return `Hey, I'm your PM Buddy. Think of me as your personal project manager for ${project.name}. I'm here to guide you, catch what you might miss and make sure this stays on track. What do you need help with?`;
}

// ── Main Component ────────────────────────────────────────────────────────────
export default function PMBuddyAssistant({ project, context }) {
  const projectId = project?.id || 'wizard';
  const [open, setOpen] = useState(false);
  const [messages, setMessages] = useState([]);
  const [input, setInput] = useState('');
  const [loading, setLoading] = useState(false);
  const [hasPopped, setHasPopped] = useState(false);
  const [unread, setUnread] = useState(0);
  const messagesEndRef = useRef(null);
  const inputRef = useRef(null);
  const { listening, start, stop, baseTextRef } = useSpeech();

  // Load saved conversation on mount
  useEffect(() => {
    const saved = loadConversation(projectId);
    if (saved.length > 0) {
      setMessages(saved);
    }
  }, [projectId]);

  // Auto-pop after 10 seconds
  useEffect(() => {
    if (hasPopped) return;
    const timer = setTimeout(() => {
      const saved = loadConversation(projectId);
      // Only show opening nudge if this is a fresh conversation
      if (saved.length === 0) {
        const nudge = buildOpeningNudge(project);
        const opening = [{ role: 'assistant', text: nudge, ts: Date.now() }];
        setMessages(opening);
        saveConversation(projectId, opening);
      }
      setOpen(true);
      setHasPopped(true);
    }, 10000);
    return () => clearTimeout(timer);
  }, [project, projectId, hasPopped]);

  // Scroll to bottom on new messages
  useEffect(() => {
    if (open) messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [messages, open]);

  // Track unread when closed
  useEffect(() => {
    if (!open && messages.length > 0) {
      const lastMsg = messages[messages.length - 1];
      if (lastMsg.role === 'assistant') setUnread(u => u + 1);
    }
  }, [messages]); // eslint-disable-line

  const handleOpen = () => { setOpen(true); setUnread(0); setTimeout(() => inputRef.current?.focus(), 100); };
  const handleClose = () => setOpen(false);

  const sendMessage = async (text) => {
    if (!text.trim() || loading) return;
    setInput('');
    baseTextRef.current = '';

    const userMsg = { role: 'user', text: text.trim(), ts: Date.now() };
    const updated = [...messages, userMsg];
    setMessages(updated);
    saveConversation(projectId, updated);
    setLoading(true);

    const projectContext = buildProjectContext(project);
    const conversationHistory = updated
      .slice(-10) // last 10 messages for context window
      .map(m => `${m.role === 'user' ? 'User' : 'PM Buddy'}: ${m.text}`)
      .join('\n');

    const prompt = `You are PM Buddy, a friendly and direct personal project manager assistant embedded inside a project management tool. You are NOT generic. You are reading this specific project's data and responding based on it.

PROJECT CONTEXT:
${projectContext}

${context ? `ADDITIONAL CONTEXT (wizard state):\n${context}\n` : ''}

CONVERSATION SO FAR:
${conversationHistory}

YOUR RULES:
- Speak in plain, everyday language. No PM jargon unless you explain it.
- Be direct and specific to THIS project. Never give generic advice.
- You can suggest things but you NEVER edit or change the user's work yourself.
- Keep responses short, 2 to 4 sentences max unless they ask for detail.
- If something is missing or risky, say it plainly and tell them why it matters.
- You are warm but honest. You are on their side.
- Never start with "Great question" or "Absolutely" or any filler.
- If they ask about risks, compliance, milestones, team, goals or documentation, give specific advice based on their project data above.

Respond only as PM Buddy. No preamble.`;

    try {
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 20000);
      const response = await fetch('/api/gemini', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prompt }),
        signal: controller.signal,
      });
      clearTimeout(timeout);
      const result = await response.json();
      const reply = (result.result || 'Sorry, I could not get a response. Try again.').trim();
      const assistantMsg = { role: 'assistant', text: reply, ts: Date.now() };
      const finalMessages = [...updated, assistantMsg];
      setMessages(finalMessages);
      saveConversation(projectId, finalMessages);
      if (!open) setUnread(u => u + 1);
    } catch {
      const errMsg = { role: 'assistant', text: 'I had trouble connecting. Check your internet and try again.', ts: Date.now() };
      const finalMessages = [...updated, errMsg];
      setMessages(finalMessages);
      saveConversation(projectId, finalMessages);
    }
    setLoading(false);
  };

  const handleKeyDown = (e) => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(input); }
  };

  const handleVoice = () => {
    if (listening) { stop(); } else { start(input, (val) => setInput(val)); }
  };

  return (
    <>
      {/* Floating bubble */}
      {!open && (
        <button onClick={handleOpen} style={s.bubble} title="PM Buddy Assistant">
          <BuddyIcon />
          {unread > 0 && <span style={s.badge}>{unread}</span>}
        </button>
      )}

      {/* Chat panel */}
      {open && (
        <div style={s.panel}>
          {/* Header */}
          <div style={s.panelHeader}>
            <div style={s.headerLeft}>
              <div style={s.avatarSmall}><BuddyIcon size={16} /></div>
              <div>
                <p style={s.headerName}>PM Buddy</p>
                <p style={s.headerSub}>Your personal project manager</p>
              </div>
            </div>
            <div style={s.headerActions}>
              <button style={s.clearBtn} onClick={() => {
                if (window.confirm('Clear this conversation?')) {
                  setMessages([]);
                  saveConversation(projectId, []);
                }
              }} title="Clear conversation">↺</button>
              <button style={s.closeBtn} onClick={handleClose}>✕</button>
            </div>
          </div>

          {/* Messages */}
          <div style={s.messages}>
            {messages.length === 0 && (
              <div style={s.emptyChat}>
                <p style={{ fontSize: 13, color: '#9CA3AF', textAlign: 'center', lineHeight: 1.6 }}>
                  Ask me anything about your project. I'm reading your data and I'll give you specific guidance.
                </p>
              </div>
            )}
            {messages.map((msg, i) => (
              <div key={i} style={{ display: 'flex', justifyContent: msg.role === 'user' ? 'flex-end' : 'flex-start', marginBottom: 10 }}>
                {msg.role === 'assistant' && (
                  <div style={s.msgAvatar}><BuddyIcon size={12} /></div>
                )}
                <div style={{
                  ...s.bubble_msg,
                  background: msg.role === 'user' ? BLUE : WH,
                  color: msg.role === 'user' ? WH : BL,
                  borderRadius: msg.role === 'user' ? '16px 16px 4px 16px' : '16px 16px 16px 4px',
                  border: msg.role === 'user' ? 'none' : '1px solid #E5E7EB',
                  marginLeft: msg.role === 'assistant' ? 6 : 0,
                }}>
                  <p style={{ fontSize: 13, lineHeight: 1.65, margin: 0 }}>{msg.text}</p>
                </div>
              </div>
            ))}
            {loading && (
              <div style={{ display: 'flex', alignItems: 'center', gap: 8, marginBottom: 10 }}>
                <div style={s.msgAvatar}><BuddyIcon size={12} /></div>
                <div style={{ ...s.bubble_msg, background: WH, border: '1px solid #E5E7EB' }}>
                  <TypingDots />
                </div>
              </div>
            )}
            <div ref={messagesEndRef} />
          </div>

          {/* Input */}
          <div style={s.inputArea}>
            {listening && (
              <div style={s.listeningBar}>
                <span style={s.listeningDot} />
                <span style={{ fontSize: 11, color: '#DC2626', fontWeight: 600 }}>Listening...</span>
              </div>
            )}
            <div style={s.inputRow}>
              <textarea
                ref={inputRef}
                style={s.input}
                placeholder="Ask PM Buddy anything..."
                value={input}
                onChange={e => { baseTextRef.current = e.target.value; setInput(e.target.value); }}
                onKeyDown={handleKeyDown}
                rows={1}
              />
              <button
                style={{ ...s.voiceBtn, background: listening ? '#DC2626' : '#F3F4F6' }}
                onClick={handleVoice}
                title={listening ? 'Stop recording' : 'Voice input'}
              >
                {listening ? <StopIcon /> : <MicIcon />}
              </button>
              <button
                style={{ ...s.sendBtn, opacity: input.trim() && !loading ? 1 : 0.4 }}
                onClick={() => sendMessage(input)}
                disabled={!input.trim() || loading}
              >
                <SendIcon />
              </button>
            </div>
          </div>
        </div>
      )}
    </>
  );
}

// ── Icons ─────────────────────────────────────────────────────────────────────
function BuddyIcon({ size = 20 }) {
  return (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
      <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2z"/>
      <path d="M8 14s1.5 2 4 2 4-2 4-2"/>
      <line x1="9" y1="9" x2="9.01" y2="9"/>
      <line x1="15" y1="9" x2="15.01" y2="9"/>
    </svg>
  );
}

function MicIcon() {
  return (
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
      <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
      <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
      <line x1="12" y1="19" x2="12" y2="23"/>
      <line x1="8" y1="23" x2="16" y2="23"/>
    </svg>
  );
}

function StopIcon() {
  return (
    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
      <rect x="4" y="4" width="16" height="16" rx="2"/>
    </svg>
  );
}

function SendIcon() {
  return (
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
      <line x1="22" y1="2" x2="11" y2="13"/>
      <polygon points="22 2 15 22 11 13 2 9 22 2"/>
    </svg>
  );
}

function TypingDots() {
  return (
    <div style={{ display: 'flex', gap: 4, alignItems: 'center', padding: '2px 0' }}>
      {[0, 1, 2].map(i => (
        <span key={i} style={{
          width: 6, height: 6, borderRadius: '50%', background: '#9CA3AF',
          display: 'inline-block',
          animation: 'pmbuddy-bounce 1.2s infinite',
          animationDelay: `${i * 0.2}s`,
        }} />
      ))}
      <style>{`
        @keyframes pmbuddy-bounce {
          0%, 60%, 100% { transform: translateY(0); }
          30% { transform: translateY(-6px); }
        }
      `}</style>
    </div>
  );
}

