{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "create-react-app",
  "redirects": [
    { "source": "/((?!api/).*)", "has": [{ "type": "host", "value": "pmbuddy-v3.vercel.app" }], "destination": "https://pmbuddy.app/$1", "permanent": true },
    { "source": "/((?!api/).*)", "has": [{ "type": "host", "value": "www.pmbuddy.app" }], "destination": "https://pmbuddy.app/$1", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/claude.js": { "maxDuration": 60 },
    "api/send-reminder.js": { "maxDuration": 15 },
    "api/check-milestones.js": { "maxDuration": 60 },
    "api/notify.js": { "maxDuration": 15 },
    "api/check-inactive-users.js": { "maxDuration": 30 },
    "api/check-inactive-users-weekly.js": { "maxDuration": 60 },
    "api/weekly-summary.js": { "maxDuration": 60 },
    "api/fortnightly-report.js": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/check-milestones",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/check-inactive-users",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/check-inactive-users-weekly",
      "schedule": "0 10 * * 1"
    },
    {
      "path": "/api/weekly-summary",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/fortnightly-report",
      "schedule": "30 7 * * 1"
    }
  ]
}
